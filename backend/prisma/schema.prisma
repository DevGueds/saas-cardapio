generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  STAFF
  CASHIER
  KITCHEN
  COURIER
  VIEWER
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

model User {
  id             String          @id @db.Uuid
  name           String          @db.VarChar(120)
  phone          String          @default("") @db.VarChar(30)
  avatarUrl      String          @default("") @db.Text
  email          String          @unique @db.VarChar(254)
  passwordHash   String          @db.VarChar(255)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  emailVerifiedAt DateTime?       @db.Timestamptz(3)
  emailVerificationDeadline DateTime @default(dbgenerated("(now() + '7 days'::interval)")) @db.Timestamptz(3)
  emailChallenge EmailVerificationChallenge?
  memberships    Membership[]
  sessions       Session[]
  mfa            MfaCredential?
  securityEvents SecurityEvent[]
  legalAcceptances LegalAcceptance[]
  privacyRequests PrivacyRequest[]
}

model EmailVerificationChallenge {
  userId    String   @id @db.Uuid
  codeHash  String   @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  retryAt   DateTime @db.Timestamptz(3)
  attempts  Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model LegalAcceptance {
  id             String   @id @db.Uuid
  userId         String   @db.Uuid
  termsVersion   String   @db.VarChar(40)
  privacyVersion String   @db.VarChar(40)
  acceptedAt     DateTime @default(now()) @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, termsVersion, privacyVersion])
  @@index([userId, acceptedAt])
}

enum PrivacyRequestKind {
  ACCESS
  CORRECTION
  DELETION
  INFORMATION
  OBJECTION
  CONSENT
}

enum PrivacyRequestStatus {
  RECEIVED
  IN_REVIEW
  COMPLETED
  DECLINED
}

model PrivacyRequest {
  id         String               @id @db.Uuid
  userId     String               @db.Uuid
  kind       PrivacyRequestKind
  message    String               @db.VarChar(1200)
  status     PrivacyRequestStatus @default(RECEIVED)
  createdAt  DateTime             @default(now()) @db.Timestamptz(3)
  resolvedAt DateTime?            @db.Timestamptz(3)
  response   String?              @db.VarChar(2000)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Tenant {
  id          String       @id @db.Uuid
  name        String       @db.VarChar(120)
  active      Boolean      @default(true)
  mfaRequired Boolean      @default(false)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  memberships Membership[]
  restaurants Restaurant[]
}

model Membership {
  tenantId    String      @db.Uuid
  userId      String      @db.Uuid
  role        Role
  active      Boolean     @default(true)
  mfaOverride MfaOverride @default(INHERIT)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([tenantId, userId])
  @@index([userId, active])
}

model Session {
  id            String    @id @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  csrfHash      String    @db.Char(64)
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  mfaVerifiedAt DateTime? @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

enum MfaOverride {
  INHERIT
  REQUIRED
  EXEMPT
}

model MfaCredential {
  userId           String    @id @db.Uuid
  secret           String    @db.VarChar(512)
  enabledAt        DateTime? @db.Timestamptz(3)
  pendingSessionId String?   @db.Uuid
  pendingExpiresAt DateTime? @db.Timestamptz(3)
  lastCounter      BigInt    @default(-1)
  recoveryHashes   Json
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecurityEvent {
  id            String   @id @db.Uuid
  actorUserId   String   @db.Uuid
  tenantId      String?  @db.Uuid
  subjectUserId String?  @db.Uuid
  action        String   @db.VarChar(40)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  actor         User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
}

model Restaurant {
  id                 String              @id @db.Uuid
  tenantId           String              @db.Uuid
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  slug               String              @unique @db.VarChar(80)
  name               String              @db.VarChar(120)
  description        String              @db.Text
  whatsapp           String              @db.VarChar(30)
  whatsappConfigured Boolean             @default(false)
  address            String              @db.VarChar(500)
  logoUrl            String              @db.Text
  coverUrl           String              @db.Text
  deliveryFee        Int                 @default(0)
  minOrder           Int                 @default(0)
  eta                String              @db.VarChar(80)
  isOpen             Boolean             @default(false)
  hours              Json?
  location           Json?
  sharing            Json?
  revision           Int                 @default(0)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  categories         Category[]
  products           Product[]
  orders             Order[]
  commerce           StoreCommerce?
  payments           Payment[]
  channel            StoreChannel?
  notifications      NotificationEvent[]
  pushSubscriptions  PushSubscription[]
  inboxReads         InboxRead[]
  printing           StorePrinting?

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model Category {
  id             String     @id @db.Uuid
  tenantId       String     @db.Uuid
  restaurantId   String     @db.Uuid
  restaurant     Restaurant @relation(fields: [tenantId, restaurantId], references: [tenantId, id], onDelete: Restrict)
  name           String     @db.VarChar(80)
  normalizedName String     @db.VarChar(80)
  products       Product[]

  @@unique([tenantId, restaurantId, id])
  @@unique([tenantId, restaurantId, normalizedName])
}

model Product {
  id           String     @id @db.Uuid
  tenantId     String     @db.Uuid
  restaurantId String     @db.Uuid
  categoryId   String     @db.Uuid
  restaurant   Restaurant @relation(fields: [tenantId, restaurantId], references: [tenantId, id], onDelete: Restrict)
  category     Category   @relation(fields: [tenantId, restaurantId, categoryId], references: [tenantId, restaurantId, id], onDelete: Restrict)
  name         String     @db.VarChar(120)
  description  String     @db.Text
  price        Int
  imageUrl     String     @db.Text
  available    Boolean    @default(true)
  popular      Boolean    @default(false)

  @@unique([tenantId, restaurantId, id])
  @@index([tenantId, restaurantId, categoryId])
}

model Order {
  id                 String              @id @db.Uuid
  tenantId           String              @db.Uuid
  restaurantId       String              @db.Uuid
  restaurant         Restaurant          @relation(fields: [tenantId, restaurantId], references: [tenantId, id], onDelete: Restrict)
  revision           Int                 @default(0)
  status             OrderStatus         @default(NEW)
  customer           Json
  items              Json
  subtotal           Int
  deliveryFee        Int
  total              Int
  discount           Int                 @default(0)
  fulfillment        Json?
  promotionId        String?             @db.Uuid
  promotionName      String?             @db.VarChar(120)
  region             String              @default("") @db.VarChar(300)
  eta                String              @default("") @db.VarChar(80)
  courierId          String?             @db.Uuid
  history            Json?
  trackingHash       String?             @db.Char(64)
  trackingExpiresAt  DateTime?           @db.Timestamptz(3)
  checkoutRevision   Int
  whatsappUrl        String              @db.Text
  idempotencyHash    String              @db.Char(64)
  payloadHash        String              @db.Char(64)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  payments           Payment[]
  whatsappConsentAt  DateTime?           @db.Timestamptz(3)
  whatsappRevokedAt  DateTime?           @db.Timestamptz(3)
  notificationEvents NotificationEvent[]
  pushSubscriptions  PushSubscription[]

  @@unique([tenantId, restaurantId, id])
  @@unique([tenantId, restaurantId, idempotencyHash])
  @@index([tenantId, restaurantId, createdAt, id])
  @@index([tenantId, restaurantId, courierId, createdAt])
  @@index([tenantId, restaurantId, status, createdAt, id])
}

model RateLimit {
  key       String   @id @db.Char(64)
  count     Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

model Payment {
  id             String     @id @db.Uuid
  tenantId       String     @db.Uuid
  restaurantId   String     @db.Uuid
  restaurant     Restaurant @relation(fields: [tenantId, restaurantId], references: [tenantId, id], onDelete: Restrict, map: "Payment_restaurant_fkey")
  orderId        String?    @db.Uuid
  order          Order?     @relation(fields: [tenantId, restaurantId, orderId], references: [tenantId, restaurantId, id], onDelete: Restrict, map: "Payment_order_fkey")
  amount         Int
  method         String     @db.VarChar(10)
  description    String     @db.VarChar(160)
  source         String     @default("MANUAL") @db.VarChar(20)
  requestHash    String     @db.Char(64)
  payloadHash    String     @db.Char(64)
  recordedBy     String     @db.Uuid
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  reversedAt     DateTime?  @db.Timestamptz(3)
  reversedBy     String?    @db.Uuid
  reversalReason String?    @db.VarChar(300)

  @@unique([tenantId, restaurantId, requestHash])
  @@index([tenantId, restaurantId, createdAt, id])
  @@index([tenantId, restaurantId, reversedAt])
  @@index([tenantId, restaurantId, orderId])
}

model StorePrinting {
  restaurantId  String     @id @db.Uuid
  tenantId      String     @db.Uuid
  revision      Int        @default(0)
  configuration Json
  restaurant    Restaurant @relation(fields: [tenantId, restaurantId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, restaurantId])
}

model StoreCommerce {
  restaurantId String     @id @db.Uuid
  tenantId     String     @db.Uuid
  restaurant   Restaurant @relation(fields: [tenantId, restaurantId], references: [tenantId, id], onDelete: Restrict)
  combos       Json
  promotions   Json
  delivery     Json
  addonGroups  Json?
  appearance   Json?

  @@unique([tenantId, restaurantId])
}

model StoreChannel {
  restaurantId    String     @id @db.Uuid
  tenantId        String     @db.Uuid
  restaurant      Restaurant @relation(fields: [tenantId, restaurantId], references: [tenantId, id], onDelete: Cascade)
  revision        Int        @default(0)
  boardEnabled    Boolean    @default(false)
  boardVersion    String     @db.Uuid
  whatsappEnabled Boolean    @default(false)

  @@unique([tenantId, restaurantId])
}

model NotificationEvent {
  id           String                 @id @db.Uuid
  tenantId     String                 @db.Uuid
  restaurantId String                 @db.Uuid
  restaurant   Restaurant             @relation(fields: [tenantId, restaurantId], references: [tenantId, id], onDelete: Cascade)
  orderId      String                 @db.Uuid
  order        Order                  @relation(fields: [tenantId, restaurantId, orderId], references: [tenantId, restaurantId, id], onDelete: Cascade)
  kind         String                 @db.VarChar(10)
  status       String                 @db.VarChar(20)
  createdAt    DateTime               @default(now()) @db.Timestamptz(3)
  expandedAt   DateTime?              @db.Timestamptz(3)
  deliveries   NotificationDelivery[]

  @@index([expandedAt, createdAt])
  @@index([tenantId, restaurantId, createdAt])
  @@index([tenantId, restaurantId, orderId, createdAt, id])
}

model PushSubscription {
  id           String     @id @db.Uuid
  tenantId     String     @db.Uuid
  restaurantId String     @db.Uuid
  restaurant   Restaurant @relation(fields: [tenantId, restaurantId], references: [tenantId, id], onDelete: Cascade)
  orderId      String?    @db.Uuid
  order        Order?     @relation(fields: [tenantId, restaurantId, orderId], references: [tenantId, restaurantId, id], onDelete: Cascade)
  userId       String?    @db.Uuid
  sessionId    String?    @db.Uuid
  endpointHash String     @db.Char(64)
  encrypted    String     @db.Text
  expiresAt    DateTime   @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, restaurantId, endpointHash])
  @@index([tenantId, restaurantId, orderId, userId])
  @@index([tenantId, restaurantId, userId, expiresAt])
  @@index([expiresAt])
}

model NotificationDelivery {
  id          String            @id @db.Uuid
  eventId     String            @db.Uuid
  event       NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  channel     String            @db.VarChar(10)
  recipient   String            @db.VarChar(100)
  state       String            @default("PENDING") @db.VarChar(12)
  attempts    Int               @default(0)
  availableAt DateTime          @default(now()) @db.Timestamptz(3)
  claimedAt   DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([eventId, channel, recipient])
  @@index([state, availableAt])
}

model InboxRead {
  tenantId     String     @db.Uuid
  restaurantId String     @db.Uuid
  userId       String     @db.Uuid
  restaurant   Restaurant @relation(fields: [tenantId, restaurantId], references: [tenantId, id], onDelete: Cascade)
  readAt       DateTime   @db.Timestamptz(3)

  @@id([tenantId, restaurantId, userId])
}
