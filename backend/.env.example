# Prefer pnpm setup:local, que gera senhas e segredo aleatórios sem sobrescrever arquivos.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_TLS=false
DATABASE_URL=mysql://cardapio:SUBSTITUA@127.0.0.1:3307/cardapio
MIGRATION_DATABASE_URL=mysql://root:SUBSTITUA@127.0.0.1:3307/cardapio
TEST_DATABASE_URL=mysql://cardapio:SUBSTITUA@127.0.0.1:3307/cardapio_test
TEST_MIGRATION_DATABASE_URL=mysql://root:SUBSTITUA@127.0.0.1:3307/cardapio_test
MYSQL_PASSWORD=SUBSTITUA
MYSQL_ROOT_PASSWORD=SUBSTITUA
SESSION_SECRET=GERE_64_CARACTERES_HEXADECIMAIS
SESSION_TTL_SECONDS=28800
CORS_ORIGINS=http://localhost:8443,http://localhost:4176
SIGNUP_ENABLED=true
DOCS_ENABLED=true
# Produção: NODE_ENV=production, DATABASE_TLS=true, DATABASE_CA_FILE se necessário,
# origens HTTPS explícitas, SIGNUP_ENABLED=false, DOCS_ENABLED=false.
