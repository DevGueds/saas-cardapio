# Prefer pnpm setup:local, que gera senhas e segredo aleatórios sem sobrescrever arquivos.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_TLS=false
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_MIGRATION_PENDING=false
DATABASE_URL=postgresql://cardapio:SUBSTITUA@127.0.0.1:5433/cardapio
MIGRATION_DATABASE_URL=postgresql://cardapio_migrator:SUBSTITUA@127.0.0.1:5433/cardapio
TEST_DATABASE_URL=postgresql://cardapio:SUBSTITUA@127.0.0.1:5433/cardapio_test
TEST_MIGRATION_DATABASE_URL=postgresql://cardapio_migrator:SUBSTITUA@127.0.0.1:5433/cardapio_test
POSTGRES_APP_PASSWORD=SUBSTITUA
POSTGRES_MIGRATION_PASSWORD=SUBSTITUA
POSTGRES_PASSWORD=SUBSTITUA
SESSION_SECRET=GERE_64_CARACTERES_HEXADECIMAIS
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=auto
CORS_ORIGINS=http://localhost:8443,http://localhost:4176
SIGNUP_ENABLED=true
DOCS_ENABLED=true
# Produção: NODE_ENV=production, DATABASE_TLS=true, DATABASE_CA_FILE se necessário,
# origens HTTPS explícitas, SIGNUP_ENABLED=false, DOCS_ENABLED=false.

REDIS_URL=redis://:SUBSTITUA@127.0.0.1:6380/0
REDIS_PASSWORD=SUBSTITUA
# Produção exige rediss:// (TLS). Proxy vazio por padrão; informe só CIDRs do balanceador.
TRUSTED_PROXY_CIDRS=
HTTP_RATE_LIMIT=600
MAX_IN_FLIGHT=128
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
LOG_LEVEL=info
LOG_DIRECTORY=logs
LOG_INSTANCE=api

# pnpm setup:local gera o par VAPID, a chave do provedor e a senha do banco isolado.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost.invalid
EVOLUTION_URL=http://127.0.0.1:8081
EVOLUTION_API_KEY=GERE_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
EVOLUTION_DATABASE_PASSWORD=SUBSTITUA
DOCKER_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
WEB_BIND_ADDRESS=127.0.0.1
# HTTPS futuro: atualizar origem pública/CORS, VAPID_SUBJECT para contato real,
# configurar TLS no proxy e NODE_ENV=production com TLS nos bancos/Redis.

# Importação legada: setup:local preserva URLs antigas em LEGACY_DATABASE_URL e
# LEGACY_MIGRATION_DATABASE_URL. Nunca forneça essas credenciais às APIs.
# LEGACY_DATABASE_TLS=true e LEGACY_DATABASE_CA_FILE são exigidos conforme o ambiente.
