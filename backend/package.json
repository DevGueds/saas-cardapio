{
  "name": "@cardapio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/main.ts",
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test && node scripts/check-architecture.mjs",
    "test": "tsc -p tsconfig.tests.json && node --test .test-build/test/unit/*.test.js",
    "test:db": "pnpm db:migrate:test && tsc -p tsconfig.tests.json && node --env-file=.env --test --test-concurrency=1 .test-build/test/integration/*.test.js",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio",
    "db:migrate:test": "node scripts/migrate-test.mjs",
    "maintenance": "node dist/maintenance.js"
  },
  "dependencies": {
    "@cardapio/contracts": "workspace:*",
    "@cardapio/domain": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "dotenv": "^17.2.3",
    "fastify": "5.12.7",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "redis": "6.3.0",
    "reflect-metadata": "^0.2.2",
    "rotating-file-stream": "^3.2.10",
    "rxjs": "^7.8.2",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "prisma": "7.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist"
  ]
}
