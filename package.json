{
  "name": "saas-cardapio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode demo",
    "dev:restricted": "vite",
    "build": "pnpm check:text && tsc --noEmit && vite build",
    "build:demo": "pnpm check:text && tsc --noEmit && vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint src && node scripts/check-architecture.mjs && pnpm check:text",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:demo",
    "format": "prettier --write .",
    "check:text": "node scripts/check-text.mjs",
    "security:secrets": "node scripts/check-secrets.mjs",
    "railway:prepare": "node .railway/prepare.mjs",
    "railway": "node scripts/railway-cli.mjs",
    "railway:check": "npm --prefix .railway run check",
    "railway:plan": "node scripts/railway-cli.mjs config plan",
    "test:railway:images": "node scripts/test-railway-images.mjs",
    "test:docker:security": "node scripts/test-docker-security.mjs",
    "format:check": "prettier --check .",
    "postinstall": "pnpm --filter @cardapio/domain build && pnpm --filter @cardapio/contracts build && pnpm --filter @cardapio/api db:generate",
    "api:dev": "pnpm --filter @cardapio/api dev",
    "api:build": "pnpm --filter @cardapio/api build",
    "api:check": "pnpm --filter @cardapio/api check",
    "api:test:db": "pnpm --filter @cardapio/api test:db",
    "dev:api": "vite --mode api",
    "setup:local": "node scripts/setup-local.mjs",
    "setup:lan": "node scripts/setup-lan.mjs",
    "db:up": "docker compose --env-file backend/.env -f compose.yaml up -d --wait postgres redis",
    "db:down": "docker compose --env-file backend/.env -f compose.yaml down",
    "db:migrate": "pnpm --filter @cardapio/api db:migrate",
    "dev:full": "node scripts/dev-full.mjs",
    "check:all": "pnpm check && pnpm api:check",
    "build:api": "pnpm check:text && tsc --noEmit && vite build --mode api",
    "test:e2e:api": "pnpm api:build && pnpm --filter @cardapio/api db:migrate:test && node scripts/test-api-browser.mjs",
    "test:e2e:api:cleanup": "pnpm --filter @cardapio/api exec node scripts/cleanup-browser-tests.mjs",
    "build:shared": "pnpm --filter @cardapio/domain build && pnpm --filter @cardapio/contracts build",
    "api:maintenance": "pnpm --filter @cardapio/api maintenance",
    "docker:migrate": "docker compose --env-file backend/.env -f compose.yaml --profile tools run --build --rm migrate",
    "docker:up": "pnpm db:up && pnpm docker:migrate && docker compose --env-file backend/.env -f compose.yaml --profile app up --build -d --wait",
    "docker:down": "docker compose --env-file backend/.env -f compose.yaml --profile app --profile tools down",
    "test:e2e:docker": "playwright test --config playwright.docker.config.ts",
    "benchmark:fixture": "pnpm --filter @cardapio/api exec node scripts/benchmark-fixture.mjs",
    "benchmark:up": "docker compose --env-file backend/.env -f compose.yaml -f compose.benchmark.yaml --profile app up -d --wait",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:cpu": "node scripts/benchmark-cpu.mjs",
    "benchmark:restore": "docker compose --env-file backend/.env -f compose.yaml --profile app up -d --wait",
    "test:docker:resilience": "node scripts/test-docker-resilience.mjs"
  },
  "dependencies": {
    "@cardapio/contracts": "workspace:*",
    "@cardapio/domain": "workspace:*",
    "@editorjs/editorjs": "2.31.7",
    "@microsoft/fetch-event-source": "2.0.1",
    "@noble/hashes": "2.4.0",
    "@point-of-sale/receipt-printer-encoder": "4.0.1",
    "@reduxjs/toolkit": "2.13.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "leaflet": "1.9.4",
    "lucide-react": "^1.52.0",
    "qr-code-styling": "1.9.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "6.1.6",
    "react-router": "7.18.4",
    "react-toastify": "11.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "1.9.22",
    "@types/node": "^22.0.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "autocannon": "8.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
